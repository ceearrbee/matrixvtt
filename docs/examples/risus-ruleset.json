  "combat": {
    "common_actions": [
      {
        "label": "Single Combat",
        "description": "Both sides roll an appropriate cliché. The round's loser loses one die from the cliché in use. At zero dice, you're out and the winner decides what that means."
      },
      {
        "label": "Inappropriate Cliché",
        "description": "Fight with a cliché that doesn't fit the conflict. If you win the round anyway, your opponent loses three dice instead of one."
      },
      {
        "label": "Pump",
        "description": "Declare extra dice before rolling. Roll them now, lose them after, win or lose. Pumped dice return at a rate the GM sets."
      },
      {
        "label": "Team Up",
        "description": "Join a team behind a leader. Helpers add their dice; sixes count double. If the team loses a round, a volunteer (or the leader) takes the die loss."
      },
      {
        "label": "Concede",
        "description": "Give up the conflict before losing your last die. You lose, but you choose how it looks."
      }
    ]
