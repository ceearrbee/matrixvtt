    },
    "spell_save_dc": {
      "$": "+",
      "args": [
        8,
        "@derived.pb",
        "@cast.mod"
      ]
    },
    "spell_attack_bonus": {
      "$": "+",
      "args": [
        "@derived.pb",
        "@cast.mod"
      ]
    },
    "passive_perception": {
      "$": "+",
      "args": [
        10,
        "@wis.mod",
        {
          "$": "if",
          "args": [
            "@proficient.perception",
            "@derived.pb",
            0
          ]
        },
        "@extra_bonuses"
      ]
    },
    "concentration_dc": {
      "$": "max",
      "args": [
        10,
        {
          "$": "floor",
