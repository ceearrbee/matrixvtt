  "state_machines": {
    "death_save": {
      "transitions": [
        {
          "when": {
            "$": "eq",
            "args": [
              "@input.roll",
              20
            ]
          },
          "set": {
            "successes": 0,
            "failures": 0,
            "status": "revive"
          }
        },
        {
          "when": {
            "$": "eq",
            "args": [
              "@input.roll",
              1
            ]
          },
          "set": {
            "failures": {
              "$": "+",
              "args": [
                "@state.failures",
                2
              ]
            }
          }
        },
        {
          "when": {
            "$": "gt",
            "args": [
              "@input.roll",
              9
            ]
          },
          "set": {
            "successes": {
              "$": "+",
              "args": [
                "@state.successes",
                1
              ]
            }
          }
        },
        {
          "when": true,
          "set": {
            "failures": {
              "$": "+",
              "args": [
                "@state.failures",
                1
              ]
            }
          }
        }
      ],
      "resolve": {
        "status": {
          "$": "if",
          "args": [
            {
              "$": "gt",
              "args": [
                "@state.failures",
                2
              ]
            },
            "dead",
            {
              "$": "if",
              "args": [
                {
                  "$": "gt",
                  "args": [
                    "@state.successes",
                    2
                  ]
                },
                "stable",
                "@state.status"
              ]
            }
          ]
        }
      }
    }
  },
