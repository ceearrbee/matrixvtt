  "stunts": [
    {
      "label": "Add a bonus",
      "pattern": "Because I [describe how you are amazing], I get +2 when I [pick one: attack, defend, create an advantage, overcome] with [a skill] when [describe a circumstance]."
    },
    {
      "label": "Rule exception",
      "pattern": "Because I [describe how you are amazing], I can use [a skill] in place of [another skill] when [describe a circumstance]."
    },
    {
      "label": "New action",
      "pattern": "Because I [describe how you are amazing], once per session I can [describe a special effect that bends the rules]."
    }
  ],
  "dice": {
    "check": "4dF"
  },
  "rolls": {
    "attribute": "4dF+{mod}",
    "skill": "4dF+{bonus}",
    "initiative": "4dF+{bonus}",
    "attack": "4dF+{bonus}"
