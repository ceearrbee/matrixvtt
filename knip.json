{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/app-client.js",
    "src/standalone/bootstrap.js",
    "src/matrix-widget-stub.js",
    "src/__tests__/**/*.test.js",
    "src/**/__tests__/**/*.test.js",
    "tests/mocks/**/*.js",
    "tests/e2e/**/*.{js,ts}"
  ],
  "project": [
    "src/**/*.{js,jsx}"
  ],
  "ignore": [
    "src/utils/no-op.js"
  ],
  "ignoreDependencies": [
    "matrix-widget-api",
    "y-protocols",
    "@testing-library/dom",
    "@types/matrix-js-sdk"
  ]
}
