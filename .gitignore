# Node modules
node_modules/

# SSL certificates (auto-generated)
.ssl/
*.pem

# OS files
.DS_Store
Thumbs.db

# Editor files
# .vscode/extensions.json is checked in (recommended extensions); ignore
# the rest of the directory so per-developer settings don't leak.
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Build outputs (if we add a build step later)
dist/
build/

# Generated icon library (rebuilt from the .zip files by scripts/build-icons.mjs)
public/icons/

# Raster app icons (rebuilt from public/icon.svg by scripts/build-pwa-icons.mjs).
# Not icon*.png, which would swallow the committed icon.svg's neighbours.
public/icon-*.png

# Logs
*.log
npm-debug.log*

# Environment files
.env
.env.local
.clone/
.clone/
.clone/
coverage/
.codex
.antigravitycli/

# VitePress
docs/.vitepress/cache/
docs/.vitepress/dist/

# Playwright
test-results/
playwright-report/
playwright/.cache/
.lighthouseci/

# Deploy artifacts from scripts/package.sh
/release/

# Generated background manifest + credits (rebuilt from public/backgrounds/
# sources.json by scripts/build-backgrounds.mjs). The tiles themselves and
# sources.json are committed - the pack is small enough to review in a diff.
public/backgrounds/index.json
public/backgrounds/LICENSE.txt
